    affiliation: "ETH Zurich and Imperial College London"
  - given-names: Marco
    family-names: Sandrin
    orcid: "https://orcid.org/0009-0007-0157-4152"
    affiliation: "Imperial College London"
version: "5.1.0"
date-released: "2026-10-26"
license: EPL-2.0   # with GPL-2.0-or-later as a Secondary License; see LICENSE
repository-code: "https://github.com/omega-icl/mcpp"
url: "https://pymcpp.readthedocs.io"
keywords:
  - factorable functions
  - expression graphs
  - automatic differentiation
  - interval arithmetic
  - convex relaxation
  - global optimization
